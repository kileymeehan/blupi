# ── Database ─────────────────────────────────────────────────────────────────
# Supabase: Settings → Database → Connection string (URI mode)
# Add ?sslmode=require for Supabase connections
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_SSL=true

# ── Session ───────────────────────────────────────────────────────────────────
# Any random 32+ char string; run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── Firebase (client-side) ────────────────────────────────────────────────────
# Firebase Console → Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server-side) ─────────────────────────────────────────
# Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Optional: enable extra features ──────────────────────────────────────────
# OPENAI_API_KEY=           # AI storyboard generation + CSV classification
# REPLICATE_API_TOKEN=      # Alternative AI image generation
# SENDGRID_API_KEY=         # Email notifications
# GOOGLE_SERVICE_ACCOUNT_KEY=  # Google Sheets integration (JSON, base64-encoded)
# GOOGLE_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PENDO_API_KEY=
