# ── Database ─────────────────────────────────────────────────────────────────
# Railway: add a PostgreSQL service, then on the app service set
#   DATABASE_URL=${{Postgres.DATABASE_URL}}   (private network, no SSL)
#   DATABASE_SSL=false
# Local dev against Railway: use the Postgres service's DATABASE_PUBLIC_URL
# instead, with DATABASE_SSL=true.
DATABASE_URL=postgresql://postgres:[password]@[host]:[port]/railway
DATABASE_SSL=false

# ── Session ───────────────────────────────────────────────────────────────────
# Any random 32+ char string; run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── Google sign-in ────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URIs: https://<your-domain>/auth/google-callback
#                           http://localhost:5000/auth/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the redirect URI can't be worked out from the request host
# GOOGLE_REDIRECT_URI=https://<your-domain>/auth/google-callback

# ── Local development only ───────────────────────────────────────────────────
# Adds a "Dev sign-in" button and /api/auth/dev-login that signs in as this
# account (created if missing). Ignored when NODE_ENV=production; never set on Railway.
# DEV_LOGIN_EMAIL=test@blupi.local
# DEV_LOGIN_PASSWORD=blupitest123

# ── Optional: enable extra features ──────────────────────────────────────────
# OPENAI_API_KEY=           # AI storyboard generation + CSV classification
# REPLICATE_API_TOKEN=      # Alternative AI image generation
# SENDGRID_API_KEY=         # Email notifications
# GOOGLE_SERVICE_ACCOUNT_KEY=  # Google Sheets integration (JSON, base64-encoded)
# GOOGLE_API_KEY=
# PENDO_API_KEY=
