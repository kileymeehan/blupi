{
  "manifest_version": 3,
  "name": "Blupi Flow Capture",
  "version": "0.1.0",
  "description": "Capture the steps of a flow on any website and turn them into a Blupi board.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Blupi Flow Capture",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "capture-step": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Capture the current page as a step"
    }
  }
}
